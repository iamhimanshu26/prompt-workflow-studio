// AI Prompt Workflow Studio — data model (Phase 0)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PromptCategory {
  RESUME
  INTERVIEW
  EMAIL
  CODING
  LEARNING
  MARKETING
  GENERAL
}

enum WorkflowStepType {
  INPUT
  PROMPT
  AI_RESPONSE
  EVALUATION
  SAVE_RESULT
}

enum AiModelId {
  GPT
  GEMINI
  CLAUDE
}

enum EvaluationSourceType {
  MANUAL
  PROMPT_RUN
  SAVED_PROMPT
  PROMPT_VERSION
}

enum EvaluationModeType {
  PROMPT_QUALITY
  OUTPUT_QUALITY
  ALIGNMENT
  PRODUCTION_READINESS
  RISK_REVIEW
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prompts     Prompt[]
  promptRuns  PromptRun[]
  evaluations Evaluation[]
  workflows   Workflow[]
  ideas       Idea[]
}

model Idea {
  id           String   @id @default(cuid())
  userId       String
  roughNotes   String   @db.Text
  refinedNotes String?  @db.Text
  isRefined    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Prompt {
  id          String         @id @default(cuid())
  userId      String
  title       String
  body        String         @db.Text
  category    PromptCategory @default(GENERAL)
  isFavorite  Boolean        @default(false)
  isTemplate  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  PromptVersion[]
  runs      PromptRun[]

  @@index([userId])
  @@index([category])
}

model PromptVersion {
  id        String   @id @default(cuid())
  promptId  String
  version   Int
  name      String
  body      String   @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@index([promptId])
}

model PromptRun {
  id           String         @id @default(cuid())
  userId       String
  promptId     String?
  promptText   String         @db.Text
  category     PromptCategory @default(GENERAL)
  modelId      AiModelId      @default(GPT)
  responseText String         @db.Text
  tokenInput   Int            @default(0)
  tokenOutput  Int            @default(0)
  latencyMs    Int            @default(0)
  createdAt    DateTime       @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      Prompt?      @relation(fields: [promptId], references: [id], onDelete: SetNull)
  evaluations Evaluation[]

  @@index([userId])
  @@index([promptId])
  @@index([createdAt])
}

model Evaluation {
  id                  String               @id @default(cuid())
  userId              String
  promptRunId         String?
  promptId            String?
  promptVersionId     String?
  sourceType          EvaluationSourceType @default(MANUAL)
  evaluationType      EvaluationModeType   @default(ALIGNMENT)
  promptText          String?              @db.Text
  responseText        String?              @db.Text
  expectedOutput      String?              @db.Text
  successCriteria     String?              @db.Text
  clarity             Int
  specificity         Int                  @default(0)
  structure           Int
  outputControl       Int                  @default(0)
  reusability         Int                  @default(0)
  reliability         Int                  @default(0)
  accuracy            Int
  usefulness          Int
  hallucinationRisk   Int
  productionReadiness Int                  @default(0)
  totalScore          Int
  rating              String?
  summary             String?              @db.Text
  strengths           Json?
  weaknesses          Json?
  recommendations     Json?
  suggestedPrompt     String?              @db.Text
  provider            String?
  latencyMs           Int?
  createdAt           DateTime             @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptRun PromptRun? @relation(fields: [promptRunId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([promptRunId])
  @@index([createdAt])
}

model Workflow {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps WorkflowStep[]

  @@index([userId])
}

model WorkflowStep {
  id         String           @id @default(cuid())
  workflowId String
  order      Int
  stepType   WorkflowStepType
  label      String
  config     Json?
  createdAt  DateTime         @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, order])
  @@index([workflowId])
}
